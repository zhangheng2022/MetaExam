  "components": [
    {
      "name": "Ant Design 主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "检查操作，呈现主题默认、悬停、按下和键盘焦点；静态 HTML/CSS 视觉预览，不运行 React。",
      "html": "<button class=\"ds-primary\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M21 11a9 9 0 1 0-2.6 7M21 4v7h-7\"/></svg><span>重新检查</span></button>",
      "css": ".ds-primary{font-family:\"Segoe UI\",\"Microsoft YaHei\",sans-serif;display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 15px;background:#1677ff;color:#fff;border:1px solid transparent;border-radius:6px;font-size:14px;box-shadow:0 2px 0 rgba(5,145,255,0.1);cursor:pointer}.ds-primary:hover{background:#4096ff}.ds-primary:active{background:#0958d9}.ds-primary:focus-visible{outline:3px solid #1677ff;outline-offset:4px}.ds-primary:disabled{background:rgba(0,0,0,.04);color:rgba(0,0,0,.25);box-shadow:none;cursor:not-allowed}"
    },
    {
      "name": "Ant Design 当前导航",
      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "深色 inline Menu 的选中项，锚点可定位到服务区域；静态 HTML/CSS 视觉预览，不运行 React。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><a class=\"ds-nav-item\" href=\"#service-heading\" aria-current=\"page\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M4 19a10 10 0 1 1 16 0H4Zm8-7 5-5M5 12h2m10 0h2M12 3v3\"/></svg><span>运行概览</span></a></nav>",
      "css": ".ds-nav{font-family:\"Segoe UI\",\"Microsoft YaHei\",sans-serif;padding:20px;background:#001529}.ds-nav-item{display:flex;align-items:center;gap:10px;min-height:54px;padding:0 24px;border-radius:8px;background:#1677ff;color:#fff;text-decoration:none;font-size:14px}.ds-nav-item:hover{color:#fff}.ds-nav-item:focus-visible{outline:3px solid #1677ff;outline-offset:4px}"
    },
