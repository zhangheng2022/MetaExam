  "narrative": {
    "overview": "延续现有运维界面基线：墨蓝导航、浅灰底、白色服务面板与克制的状态色，优先帮助本机维护人员读懂真实状态。网页与 Electron 复用同一组件和数据契约；字体与内联 SVG 标识无需联网加载。\n\n本文从 `packages/ui/src/styles.css`、`packages/ui/src/index.tsx` 及本轮桌面、移动端、首次连接失败截图提取。未保存用户选定的 Creative North Star、FORM seed 或 QUALITY BAR，亦无批准的视觉稿；不补造这些承诺。",
    "keyCharacteristics": [
      "状态文字明确，色彩辅助判断。",
      "服务列表集中呈现，授权说明保持独立。",
      "平面分层、细分隔线与适度圆角。",
      "采用离线系统字体，不依赖栅格素材。"
    ],
    "rules": [
      {
        "name": "文字伴随状态",
        "body": "状态必须同时给出可读文字；成功、待检查和连接中断不能只靠颜色区分。",
        "section": "colors"
      },
      {
        "name": "未知状态",
        "body": "首次请求结束但失败时，考试服务显示“连接失败”，数据库、后台任务与授权显示“无法获取”，页脚显示“尚未获取检查结果”；不能把未知状态写成“未激活”或持续检查中。",
        "section": "components"
      },
      {
        "name": "旧结果标识",
        "body": "已有成功结果后刷新失败，保留上次数据及其时间，同时显示连接中断与“以下为上次检查结果，可能已过时。”；不能把缓存结果呈现为新鲜结果。",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** 用明确的文字区分加载、成功、异常、未知和过期结果。",
      "**Do** 保留离线字体、键盘焦点与移动端可读的服务行结构。",
      "**Do** 从真实返回值生成授权信息与检查时间。"
    ],
    "donts": [
      "**Don't** 把首次连接失败表示为确定的授权或数据库结论。",
      "**Don't** 将当前技术验证界面写成正式考试功能已经开放。",
      "**Don't** 将缺失的视觉方向稿、FORM seed 或 QUALITY BAR 记录为已批准。"
    ]
  }
