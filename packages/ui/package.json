{
  "name": "@metaexam/ui",
  "version": "0.1.23",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.tsx",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./issuer": {
      "types": "./dist/issuer.d.ts",
      "default": "./dist/issuer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@metaexam/contracts": "workspace:*",
    "antd": "6.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "files": [
    "dist",
    "src/styles.css"
  ]
}
