{
  "name": "@metaexam/issuer",
  "version": "0.1.6",
  "private": true,
  "description": "MetaExam offline supplier license issuer",
  "author": "MetaExam",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json",
    "start": "electron ."
  },
  "devDependencies": {
    "@metaexam/contracts": "workspace:*",
    "@metaexam/domain": "workspace:*",
    "@metaexam/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "electron": "45.5.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "cn.metaexam.issuer",
    "productName": "MetaExam.Issuer",
    "asar": true,
    "files": [
      "dist/main.js",
      "dist/preload.js",
      "dist/host.js",
      "renderer-dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "../../artifacts/issuer-desktop"
    },
    "win": {
      "target": "dir",
      "signExecutable": false,
      "icon": "../../packages/ui/public/brand/icon.ico"
    },
    "npmRebuild": false
  }
}
