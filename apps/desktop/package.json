{
  "name": "@metaexam/desktop",
  "productName": "MetaExam Manager",
  "description": "MetaExam local service manager",
  "author": "MetaExam",
  "version": "0.1.21",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "45.5.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "@metaexam/contracts": "workspace:*",
    "@metaexam/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "build": {
    "appId": "cn.metaexam.manager",
    "productName": "MetaExam.Manager",
    "asar": true,
    "files": [
      "dist/**/*",
      "renderer-dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "../../artifacts/desktop"
    },
    "win": {
      "target": "dir",
      "signExecutable": false,
      "icon": "../../packages/ui/public/brand/icon.ico"
    },
    "npmRebuild": false
  }
}
