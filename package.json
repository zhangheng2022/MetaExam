{
  "name": "metaexam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "node tools/dev.mjs --web-only",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,packages,tests,tools,installer,provider,docs}/**/*\" \"*.{json,md,yaml,mjs,js,cjs}\" \".playwright/*.json\" --ignore-unknown",
    "format:check": "prettier --check \"{apps,packages,tests,tools,installer,provider,docs}/**/*\" \"*.{json,md,yaml,mjs,js,cjs}\" \".playwright/*.json\" --ignore-unknown",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:ui": "node tests/ui.mjs",
    "test:package": "node tests/package.mjs",
    "test:db-restart": "node tests/database-restart.mjs",
    "db:migrate": "node apps/worker/dist/cli.js migrate",
    "db:start": "node tools/postgres.mjs start",
    "db:stop": "node tools/postgres.mjs stop",
    "license:request": "node apps/worker/dist/cli.js license-request",
    "license:verify": "node apps/worker/dist/cli.js license-verify",
    "license:import": "node apps/worker/dist/cli.js license-import",
    "license:status": "node apps/worker/dist/cli.js license-status",
    "package:win": "node installer/build.mjs",
    "dev:backend": "tsc-watch -b tsconfig.dev.json --noClear --onSuccess \"pnpm run dev:services\"",
    "dev:services": "concurrently --kill-others --names api,worker \"node apps/api/dist/main.js\" \"node apps/worker/dist/main.js\"",
    "test:dev": "node tests/dev.mjs",
    "test:web-dev": "tsx tests/web-dev.mts",
    "test:m1": "tsx tests/migrations.mts && tsx tests/identity.mts && tsx tests/setup.mts && tsx tests/auth.mts && tsx tests/storage.mts && tsx tests/desktop-setup.mts && tsx tests/auth-ui.mts",
    "setup:token": "node apps/worker/dist/cli.js setup-token",
    "test:management": "tsx tests/management.mts && tsx tests/management-ui.mts",
    "test:questions": "tsx tests/questions.mts && tsx tests/questions-ui.mts",
    "test:imports": "tsx tests/imports.mts && tsx tests/imports-ui.mts",
    "test:papers": "tsx tests/papers.mts && tsx tests/papers-ui.mts",
    "test:exams": "tsx tests/exams.mts && tsx tests/exams-ui.mts",
    "test:attempts": "tsx tests/attempts.mts && tsx tests/admissions.mts && tsx tests/attempts-ui.mts",
    "test:installer": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tests/installer-acl.ps1",
    "test:grading": "tsx tests/grading.mts && tsx tests/grading-ui.mts",
    "test:reports": "tsx tests/reports.mts && tsx tests/reports-ui.mts"
  },
  "devDependencies": {
    "@ant-design/cli": "6.7.2",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.15",
    "@nestjs/skills": "0.1.1",
    "@playwright/cli": "0.1.25",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.7",
    "electron-builder": "26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "playwright": "1.65.1",
    "prettier": "3.6.2",
    "tsc-watch": "7.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
